# The repo is edited on Windows and built on Ubuntu CI. core.autocrlf is off,
# so pin line endings for the files where they matter.
* text=auto eol=lf

gradlew   text eol=lf
*.sh      text eol=lf
Makefile  text eol=lf

# Windows batch launcher must stay CRLF to run under cmd.exe.
*.bat     text eol=crlf

# Binary: never touch the wrapper jar.
gradle/wrapper/gradle-wrapper.jar binary
